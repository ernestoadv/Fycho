{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@assets/*": [
        "./assets/*"
      ],
      "@components/*": [
        "./app/components/*"
      ],
      "@defs/*": [
        "./app/defs/*"
      ],
      "@hooks/*": [
        "./app/hooks/*"
      ],
      "@screens/*": [
        "./app/screens/*"
      ],
      "@store/*": [
        "./app/store/*"
      ],
      "@style/*": [
        "./app/style/*"
      ],
      "@utils/*": [
        "./app/utils/*"
      ],
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
